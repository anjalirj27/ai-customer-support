# Database (postgresql:// is automatically upgraded to the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/customer_support
DATABASE_ECHO=false

# AI provider: "groq" or "openai"
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4-turbo-preview

# App
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Max chat requests per minute per client IP
RATE_LIMIT_PER_MINUTE=20

# Allowed browser origins, as a JSON list. Add your deployed frontend URL here.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
